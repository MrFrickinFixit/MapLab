    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>MapLab-1.0.0-beta</AssemblyName>
    <RootNamespace>TimingTableCalculator</RootNamespace>
    <Title>Map Lab</Title>
    <Product>Map Lab</Product>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Authors>Brian Diffenbaugh</Authors>
    <Copyright>Copyright (c) 2026 Brian Diffenbaugh</Copyright>
    <Description>Engine ignition timing and fueling map editor.</Description>
    <ApplicationIcon>Assets\MapLab.ico</ApplicationIcon>
    <StartupObject>TimingTableCalculator.App</StartupObject>
    <PackageId></PackageId>
    <AssemblyTitle>MapLab-1.0.0-beta</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\MapLabIcon.png" />
    <None Update="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
