<Window x:Class="TimingTableCalculator.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Map Lab" Height="900" Width="1500" MinHeight="700" MinWidth="1120" WindowStartupLocation="CenterScreen" WindowState="Maximized" Background="#F3F3F3" FontFamily="Segoe UI">
 <Window.Resources>
  <SolidColorBrush x:Key="Panel" Color="#FFFFFF"/><SolidColorBrush x:Key="Line" Color="#D1D1D1"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#202020"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#5E5E5E"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
  <Style x:Key="Input" TargetType="TextBox"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#202020"/><Setter Property="BorderBrush" Value="#B8B8B8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="13"/><Setter Property="CaretBrush" Value="#0067C0"/></Style>
  <Style x:Key="Primary" TargetType="Button"><Setter Property="Background" Value="#0067C0"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#005AA3"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,8"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource Primary}"><Setter Property="Background" Value="#F9F9F9"/><Setter Property="Foreground" Value="#202020"/><Setter Property="BorderBrush" Value="#BEBEBE"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style TargetType="TabItem">
   <Setter Property="Background" Value="#E8E8E8"/><Setter Property="Foreground" Value="#202020"/><Setter Property="Padding" Value="18,9"/><Setter Property="Margin" Value="0,0,5,0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Panel.ZIndex" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="#C8C8C8" BorderThickness="1" CornerRadius="5,5,0,0" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="White"/><Setter Property="Foreground" Value="#0067C0"/><Setter Property="Panel.ZIndex" Value="10"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="#0067C0"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#F7F7F7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <TabControl Background="#F3F3F3" BorderThickness="0">
 <TabItem Header="FUELING">
  <Grid Margin="18"><ContentControl x:Name="FuelingHost"/></Grid>
 </TabItem>
 <TabItem Header="IGNITION TIMING">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="TIMING LAB" Foreground="#0067C0" FontSize="12" FontWeight="Bold"/><TextBlock Text="Ignition Timing" FontSize="28" FontWeight="SemiBold" Margin="0,3,0,0"/><TextBlock Text="Build smooth, adjustable maps from your operating range." Foreground="#5E5E5E" FontSize="13" Margin="0,5,0,0"/></StackPanel>
   <Border Grid.Column="1" Background="#111D27" BorderBrush="#244035" BorderThickness="1" CornerRadius="16" Padding="14,8" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#55D6BE" Margin="0,0,8,0"/><TextBlock x:Name="StatusText" Text="Table ready" Foreground="#A9C9C0" FontSize="12"/></StackPanel></Border>
  </Grid>
  <StackPanel Visibility="Collapsed"><ComboBox x:Name="ApplicationBox" SelectionChanged="Application_Changed" SelectedIndex="0"><ComboBoxItem Content="kPa absolute"/><ComboBoxItem Content="PSI gauge"/></ComboBox><TextBox x:Name="IdleRpmBox" Text="1200"/><TextBox x:Name="WotMapBox" Text="85"/><TextBlock x:Name="WotMapLabel"/><TextBox x:Name="IdleMapBox"/><TextBox x:Name="WotRpmBox"/><TextBlock x:Name="IdleMapLabel"/><TextBox x:Name="LowTimingBox" Text="42"/><TextBox x:Name="HighTimingBox" Text="12"/><TextBox x:Name="MinRpmBox" Text="500"/><TextBox x:Name="MaxRpmBox" Text="7000"/><TextBlock x:Name="MinMapLabel"/><TextBox x:Name="MinMapBox" Text="20"/><TextBlock x:Name="MaxMapLabel"/><TextBox x:Name="MaxMapBox" Text="100"/></StackPanel>
  <Border Grid.Row="2" Background="#080D14" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="3"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="False"><Grid x:Name="TableGrid" Background="#0A1019" HorizontalAlignment="Left" VerticalAlignment="Top"/></ScrollViewer></Border>
  <StackPanel Grid.Row="1" Margin="0,0,0,10">
   <TextBlock x:Name="AxisHelpText" Text="MAP kPa absolute (Y) and RPM (X) axes are editable  •  Drag across timing cells to select" Foreground="#76879C" FontSize="11" Margin="2,0,0,5"/>
   <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal">
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,7,0"><StackPanel><TextBlock Style="{StaticResource Label}" Text="TIMING SETUP TOOLS"/><StackPanel Orientation="Horizontal"><TextBlock Text="MAP UNITS" Foreground="#5E5E5E" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="TimingMapUnitBox" Width="112" Height="32" SelectedIndex="0" SelectionChanged="TimingMapUnit_Changed" Background="White" Foreground="#202020" BorderBrush="#B8B8B8" Padding="6,3" Margin="0,0,10,0"><ComboBoxItem Content="kPa absolute"/><ComboBoxItem Content="PSI gauge"/></ComboBox><Button Style="{StaticResource Primary}" Content="◫  Regions" Click="RegionTiming_Click" Margin="0,0,5,0"/><Button Style="{StaticResource Primary}" Click="BoostRetard_Click"><StackPanel Orientation="Horizontal"><Viewbox Width="17" Height="17" Margin="0,0,7,0"><Canvas Width="16" Height="16"><Path Data="M 8,1 C 11.9,1 15,4.1 15,8 C 15,11.9 11.9,15 8,15 C 4.7,15 2,12.3 2,9 C 2,6.2 4.2,4 7,4 C 9.2,4 11,5.8 11,8 C 11,9.7 9.7,11 8,11 C 6.9,11 6,10.1 6,9 C 6,8.2 6.7,7.5 7.5,7.5" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/><Path Data="M 14.8,8 L 16,8 L 16,11" Stroke="White" StrokeThickness="1.8" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox><TextBlock Text="Boost" Foreground="White" VerticalAlignment="Center"/></StackPanel></Button><Button Style="{StaticResource Secondary}" Content="⇧  Convert to Boosted" Click="ConvertTimingToBoosted_Click" Margin="5,0,0,0"/></StackPanel></StackPanel></Border>
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,7,0"><StackPanel><TextBlock Style="{StaticResource Label}" Text="MATRIX &amp; AXES SETUP"/><StackPanel Orientation="Horizontal"><TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBox x:Name="MatrixXSizeBox" Text="31" Width="44" Padding="6" TextAlignment="Center" Style="{StaticResource Input}" Margin="0,0,6,0"/><TextBlock Text="Y" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBox x:Name="MatrixYSizeBox" Text="31" Width="44" Padding="6" TextAlignment="Center" Style="{StaticResource Input}" Margin="0,0,6,0"/><Button Style="{StaticResource Primary}" Content="▦  Resize" Click="ResizeMatrix_Click" Margin="0,0,5,0"/><Button x:Name="SetRegionBoundariesButton" Style="{StaticResource Primary}" Content="⌖  Set boundaries" Click="BeginRegionBoundaryPick_Click" Margin="0,0,7,0"/><TextBlock Text="Hover map • click to lock" Foreground="#5E5E5E" FontSize="10" VerticalAlignment="Center"/></StackPanel></StackPanel></Border>
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,7,0"><StackPanel><TextBlock Style="{StaticResource Label}" Text="CELL EDITING"/><StackPanel Orientation="Horizontal"><Button Style="{StaticResource Secondary}" Content="⧉  Copy" Click="Copy_Click" Margin="0,0,5,0"/><Button Style="{StaticResource Secondary}" Content="▣  Paste" Click="Paste_Click" Margin="0,0,5,0"/><Button Style="{StaticResource Secondary}" Content="×  Clear" Click="Clear_Click"/></StackPanel></StackPanel></Border>
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,7,0"><StackPanel><TextBlock Style="{StaticResource Label}" Text="SMOOTHING"/><StackPanel Orientation="Horizontal"><Button Style="{StaticResource Secondary}" Content="⌁  Interpolate" Click="Interpolate_Click" Margin="0,0,5,0"/><Button Style="{StaticResource Primary}" Content="⚙  Smooth Selected…" Click="AdvancedSmooth_Click" Margin="0,0,5,0"/><Button Style="{StaticResource Secondary}" Content="↕  Columns" Click="SmoothColumns_Click" Margin="0,0,5,0"/><Button Style="{StaticResource Secondary}" Content="↔  Rows" Click="SmoothRows_Click"/></StackPanel></StackPanel></Border>
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,7,0"><StackPanel><TextBlock Style="{StaticResource Label}" Text="TIMING NUMBER DISPLAY"/><StackPanel Orientation="Horizontal"><TextBlock Text="LEADING DIGITS" FontSize="10" FontWeight="SemiBold" Foreground="#5E5E5E" VerticalAlignment="Center" Margin="0,0,5,0"/><ComboBox x:Name="TimingLeadingPrecisionBox" Width="48" Height="30" SelectedIndex="2" SelectionChanged="TimingDisplayPrecision_Changed" Margin="0,0,9,0"><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/></ComboBox><TextBlock Text="TRAILING DECIMALS" FontSize="10" FontWeight="SemiBold" Foreground="#5E5E5E" VerticalAlignment="Center" Margin="0,0,5,0"/><ComboBox x:Name="TimingTrailingPrecisionBox" Width="48" Height="30" SelectedIndex="1" SelectionChanged="TimingDisplayPrecision_Changed"><ComboBoxItem Content="0"/><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/></ComboBox></StackPanel></StackPanel></Border>
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,7,0"><StackPanel><TextBlock Style="{StaticResource Label}" Text="VIEW &amp; OUTPUT"/><StackPanel Orientation="Horizontal"><Button Style="{StaticResource Secondary}" Content="◉  Colors" Click="Colors_Click" Margin="0,0,5,0"/><Button Style="{StaticResource Secondary}" Content="▦  3D Map" Click="View3D_Click" Margin="0,0,5,0"/><Button Style="{StaticResource Secondary}" Content="⇩  Export CSV" Click="Export_Click" Margin="0,0,5,0"/><Button Style="{StaticResource Primary}" Content="▤  Export Excel" Click="ExportExcel_Click"/></StackPanel></StackPanel></Border>
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="8"><StackPanel><TextBlock Style="{StaticResource Label}" Text="HISTORY"/><StackPanel Orientation="Horizontal"><Button Style="{StaticResource Secondary}" Content="↶  Undo" Click="Undo_Click" Margin="0,0,6,0"/><Button Style="{StaticResource Secondary}" Content="↷  Redo" Click="Redo_Click"/></StackPanel></StackPanel></Border>
   </StackPanel></ScrollViewer>
  </StackPanel>
 </Grid>
 </TabItem>
 <TabItem Header="MAP SANDBOX">
  <Grid Margin="18"><ContentControl x:Name="SandboxHost"/></Grid>
 </TabItem>
 <TabItem Header="SETTINGS">
  <Grid Margin="24">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
   <StackPanel Margin="4,0,0,20"><TextBlock Text="MAP LAB" Foreground="#0067C0" FontSize="12" FontWeight="Bold"/><TextBlock Text="Settings Import &amp; Export" FontSize="28" FontWeight="SemiBold" Margin="0,3,0,0"/><TextBlock Text="Move or back up the complete Map Lab workspace in one file." Foreground="#5E5E5E" FontSize="13" Margin="0,5,0,0"/></StackPanel>
   <Border Grid.Row="1" Width="620" HorizontalAlignment="Left" Background="White" BorderBrush="#D1D1D1" BorderThickness="1" CornerRadius="7" Padding="20">
    <StackPanel>
     <TextBlock Text="MAP LAB SETTINGS FILE" Foreground="#5E5E5E" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <TextBlock Text="A .map file includes the Ignition Timing, Fueling, and Map Sandbox tables along with their axes, units, boundaries, display preferences, smoothing options, heat-map colors, and VE setup values." TextWrapping="Wrap" Foreground="#202020" FontSize="13" LineHeight="20" Margin="0,0,0,16"/>
     <StackPanel Orientation="Horizontal"><Button Style="{StaticResource Primary}" Content="⇧  Export .map" Click="ExportMapSettings_Click" Margin="0,0,8,0"/><Button Style="{StaticResource Secondary}" Content="⇩  Import .map" Click="ImportMapSettings_Click"/></StackPanel>
     <TextBlock x:Name="SettingsStatusText" Text="Settings are also autosaved locally while you work." Foreground="#5E5E5E" FontSize="11" Margin="0,14,0,0"/>
    </StackPanel>
   </Border>
  </Grid>
 </TabItem>
 <TabItem Header="HELP">
  <Grid Margin="18"><ContentControl x:Name="HelpHost"/></Grid>
 </TabItem>
 <TabItem Header="ABOUT">
  <Grid Margin="18"><ContentControl x:Name="AboutHost"/></Grid>
 </TabItem>
 </TabControl>
</Window>
