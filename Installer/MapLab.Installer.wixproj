<Project Sdk="WixToolset.Sdk/5.0.2">

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <Version Condition="'$(Version)' == ''">1.0.3</Version>
    <OutputName>MapLab-$(Version)-beta-win-x64</OutputName>
    <DefineConstants>PublishDir=$(PublishDir);ProductVersion=$(Version);ProjectRoot=$(MSBuildProjectDirectory)\..</DefineConstants>
  </PropertyGroup>

  <Target Name="VerifyPublishedApplication" BeforeTargets="Build">
    <Error Condition="'$(PublishDir)' == ''" Text="PublishDir must point to the self-contained Map Lab publish directory." />
    <Error Condition="!Exists('$(PublishDir)\MapLab-1.0.3-beta.exe')" Text="MapLab-1.0.3-beta.exe was not found in PublishDir. Run scripts\build-installer.ps1 from the repository root." />
  </Target>

</Project>
