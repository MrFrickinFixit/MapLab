<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="Map Lab (Beta)"
    Manufacturer="Map Lab"
    Version="$(var.ProductVersion)"
    UpgradeCode="7C642D73-845B-4DB7-89A4-F37FE4114870"
    Scope="perUserOrMachine">

    <SummaryInformation Description="Map Lab (Beta) installer" Manufacturer="Map Lab" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Map Lab is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Icon Id="MapLabIcon.ico" SourceFile="$(var.ProjectRoot)\Assets\MapLab.ico" />
    <Property Id="ARPPRODUCTICON" Value="MapLabIcon.ico" />

    <!-- The welcome dialog is overridden so setup always walks through scope,
         destination-folder, and shortcut-feature selection. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.ProjectRoot)\Installer\License.rtf" />
    <Property Id="ApplicationFolderName" Value="Map Lab" />
    <Property Id="WixAppFolder" Value="WixPerMachineFolder" />
    <UIRef Id="MapLabPromptedUI" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="APPLICATIONFOLDER" Name="Map Lab" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="MapLabProgramMenuFolder" Name="Map Lab">
        <Component Id="StartMenuShortcutComponent" Guid="*">
          <Shortcut
            Id="StartMenuShortcut"
            Name="Map Lab"
            Description="Open Map Lab"
            Target="[APPLICATIONFOLDER]MapLab-1.0.0-beta.exe"
            Icon="MapLabIcon.ico"
            WorkingDirectory="APPLICATIONFOLDER" />
          <RemoveFolder Id="RemoveMapLabProgramMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\Map Lab" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="*">
        <Shortcut
          Id="DesktopShortcut"
          Name="Map Lab"
          Description="Open Map Lab"
          Target="[APPLICATIONFOLDER]MapLab-1.0.0-beta.exe"
          Icon="MapLabIcon.ico"
          WorkingDirectory="APPLICATIONFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\Map Lab" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature
      Id="MapLabFeature"
      Title="Map Lab application"
      Description="Required application files and legal notices."
      Level="1"
      AllowAbsent="no"
      ConfigurableDirectory="APPLICATIONFOLDER"
      Display="expand">
      <Files Include="$(var.PublishDir)\**" Directory="APPLICATIONFOLDER" />
      <Feature Id="StartMenuShortcutFeature" Title="Start menu shortcut" Description="Add Map Lab to the Windows Start menu." Level="1" AllowAbsent="yes" AllowAdvertise="no">
        <ComponentRef Id="StartMenuShortcutComponent" />
      </Feature>
      <Feature Id="DesktopShortcutFeature" Title="Desktop shortcut" Description="Add a Map Lab shortcut to the desktop." Level="1" AllowAbsent="yes" AllowAdvertise="no">
        <ComponentRef Id="DesktopShortcutComponent" />
      </Feature>
    </Feature>
  </Package>
</Wix>
